__pycache__/
*.py[cod]
.venv/
venv/
.env

# 真实账号配置（含加密后的 token），切勿提交
config/accounts.yaml
# 外部通知渠道（含推送 key），切勿提交
config/settings.yaml
# 配置备份与临时文件
config/accounts.yaml.bak
config/accounts.yaml.tmp
# 本机加密密钥，丢失后已保存的 token 将无法解密
config/.secret.key

# 本地历史快照数据库（锚定到仓库根，避免误伤子目录）
/data/

.idea/
.vscode/
*.log
.DS_Store
